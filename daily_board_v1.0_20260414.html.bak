<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>每日经济热点案例展示板 · 2026年4月21日 · V1.1</title>
  <style>
    :root {
      --primary: #1a2942;
      --accent: #c8102e;
      --gold: #d4a017;
      --teal: #0f7173;
      --green: #1a9e5c;
      --red: #e63329;
      --light-bg: #f4f6fb;
      --card-bg: #ffffff;
      --border: #e0e6ef;
      --text-main: #1c2a42;
      --text-sub: #5a6a80;
      --shadow: 0 2px 12px rgba(0,0,0,0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'PingFang SC', 'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif;
      background: var(--light-bg);
      color: var(--text-main);
      min-height: 100vh;
    }

    /* ─── HEADER ─── */
    .header {
      background: linear-gradient(135deg, #0e1e3a 0%, #1a3464 60%, #0d2137 100%);
      padding: 0;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 3px 20px rgba(0,0,0,0.3);
    }
    .header-inner {
      max-width: 1600px;
      margin: 0 auto;
      padding: 14px 28px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
    }
    .header-left { display: flex; align-items: center; gap: 16px; }
    .header-logo { display: flex; align-items: center; gap: 10px; }
    .logo-icon {
      width: 44px; height: 44px;
      background: linear-gradient(135deg, var(--accent) 0%, #ff6b35 100%);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 22px;
      box-shadow: 0 2px 10px rgba(200,16,46,0.4);
    }
    .header-title { display: flex; flex-direction: column; }
    .header-title h1 { font-size: 20px; font-weight: 700; color: #ffffff; letter-spacing: 1px; }
    .header-title .subtitle { font-size: 12px; color: rgba(255,255,255,0.55); letter-spacing: 0.5px; margin-top: 2px; }
    .header-meta { display: flex; align-items: center; gap: 18px; }
    .date-badge {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      padding: 6px 14px;
      color: #fff; font-size: 13px; font-weight: 500;
    }
    .version-badge {
      background: linear-gradient(135deg, var(--gold), #b8860b);
      border-radius: 6px;
      padding: 4px 10px;
      color: #fff; font-size: 11px; font-weight: 700;
      letter-spacing: 0.5px;
    }
    .market-status { display: flex; align-items: center; gap: 8px; }
    .status-dot {
      width: 8px; height: 8px;
      background: #22c55e; border-radius: 50%;
      box-shadow: 0 0 0 3px rgba(34,197,94,0.25);
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%,100% { box-shadow: 0 0 0 3px rgba(34,197,94,0.25); }
      50% { box-shadow: 0 0 0 6px rgba(34,197,94,0.1); }
    }
    .status-text { color: #22c55e; font-size: 12px; font-weight: 600; }

    /* ─── TICKER BAR ─── */
    .ticker-bar {
      background: #0a1628;
      border-top: 1px solid rgba(255,255,255,0.06);
      overflow: hidden;
      padding: 6px 0;
    }
    .ticker-inner {
      max-width: 1600px; margin: 0 auto; padding: 0 28px;
      display: flex; gap: 28px; overflow-x: auto; scrollbar-width: none;
    }
    .ticker-inner::-webkit-scrollbar { display: none; }
    .ticker-item { display: flex; align-items: center; gap: 8px; white-space: nowrap; }
    .ticker-label { font-size: 11px; color: rgba(255,255,255,0.45); }
    .ticker-val { font-size: 13px; font-weight: 700; color: #fff; }
    .ticker-chg { font-size: 11px; font-weight: 600; }
    .up { color: var(--red); }
    .down { color: var(--green); }
    .neutral { color: rgba(255,255,255,0.6); }
    .sep { width: 1px; height: 16px; background: rgba(255,255,255,0.1); }

    /* ─── NAV TABS ─── */
    .nav-tabs {
      background: #fff;
      border-bottom: 2px solid var(--border);
      position: sticky; top: 88px; z-index: 90;
    }
    .nav-inner {
      max-width: 1600px; margin: 0 auto; padding: 0 28px;
      display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none;
    }
    .nav-inner::-webkit-scrollbar { display: none; }
    .nav-tab {
      display: flex; align-items: center; gap: 6px;
      padding: 14px 18px;
      font-size: 13px; font-weight: 600;
      color: var(--text-sub);
      cursor: pointer;
      border-bottom: 3px solid transparent;
      white-space: nowrap;
      transition: all 0.2s;
      text-decoration: none;
    }
    .nav-tab:hover { color: var(--primary); background: #f4f6fb; }
    .nav-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
    .nav-tab .tab-icon { font-size: 16px; }
    .nav-tab .new-badge {
      font-size: 9px; font-weight: 800;
      background: var(--accent); color: #fff;
      padding: 1px 5px; border-radius: 4px;
      letter-spacing: 0.3px;
    }

    /* ─── MAIN CONTENT ─── */
    .main { max-width: 1600px; margin: 0 auto; padding: 24px 28px 48px; }
    .section-wrapper { display: none; }
    .section-wrapper.active { display: block; }
    html { scroll-behavior: smooth; }

    /* ─── SECTION HEADER ─── */
    .section-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 20px; padding-bottom: 14px;
      border-bottom: 2px solid var(--border);
    }
    .section-title { display: flex; align-items: center; gap: 12px; }
    .section-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
    .section-title h2 { font-size: 18px; font-weight: 700; color: var(--primary); }
    .section-title .section-desc { font-size: 12px; color: var(--text-sub); margin-top: 2px; }
    .section-badge { font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 20px; }

    /* ══════════════════════════════════════════════
       【一图看懂】板块专属样式 — 手机优先设计
       ══════════════════════════════════════════════ */

    /* 顶部情绪仪表盘 */
    .sentiment-bar {
      background: #fff;
      border-radius: 14px;
      padding: 16px 20px;
      margin-bottom: 16px;
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
    }
    .sentiment-label { font-size: 11px; color: var(--text-sub); margin-bottom: 10px; font-weight: 600; letter-spacing: 0.5px; }
    .sentiment-track {
      display: flex; border-radius: 8px; overflow: hidden; height: 10px; margin-bottom: 8px;
    }
    .seg-bear { background: var(--green); }
    .seg-neutral { background: #adb5bd; }
    .seg-bull { background: var(--red); }
    .sentiment-tags {
      display: flex; justify-content: space-between;
      font-size: 11px; color: var(--text-sub);
    }
    .sentiment-today {
      display: inline-block;
      margin-top: 10px;
      background: #fff3cd;
      border-left: 3px solid var(--gold);
      padding: 6px 12px;
      border-radius: 0 8px 8px 0;
      font-size: 12px; font-weight: 600; color: #7a5500;
      width: 100%;
    }

    /* 快速行情数据行 */
    .quick-market {
      display: flex; gap: 10px; margin-bottom: 16px; overflow-x: auto; scrollbar-width: none;
    }
    .quick-market::-webkit-scrollbar { display: none; }
    .qm-item {
      background: #fff;
      border-radius: 10px;
      padding: 10px 14px;
      min-width: 100px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      flex-shrink: 0;
      text-align: center;
    }
    .qm-name { font-size: 10px; color: var(--text-sub); margin-bottom: 4px; }
    .qm-val { font-size: 16px; font-weight: 800; }
    .qm-chg { font-size: 10px; font-weight: 600; margin-top: 2px; }

    /* 热点卡片容器 */
    .hot5-list { display: flex; flex-direction: column; gap: 12px; }

    /* 单张热点卡片 */
    .hot-card {
      background: #fff;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
      display: flex;
      transition: box-shadow 0.2s, transform 0.15s;
      cursor: pointer;
    }
    .hot-card:hover {
      box-shadow: 0 6px 24px rgba(0,0,0,0.13);
      transform: translateY(-1px);
    }

    /* 左色条 */
    .hc-strip {
      width: 5px;
      flex-shrink: 0;
    }

    /* 卡片主体 */
    .hc-body {
      flex: 1;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    /* 顶行：序号 + 领域标签 + 重要度 */
    .hc-top {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .hc-num {
      width: 22px; height: 22px;
      border-radius: 6px;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 800; color: #fff;
      flex-shrink: 0;
    }
    .hc-domain {
      font-size: 11px; font-weight: 700;
      padding: 2px 8px; border-radius: 10px;
    }
    .hc-importance {
      margin-left: auto;
      font-size: 10px; font-weight: 700;
      padding: 2px 7px; border-radius: 8px;
    }

    /* 一句话结论 */
    .hc-headline {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.45;
    }

    /* 核心数据区 */
    .hc-metrics {
      display: flex;
      gap: 12px;
    }
    .hc-metric {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .hc-metric-val {
      font-size: 22px;
      font-weight: 900;
      line-height: 1.1;
      letter-spacing: -0.5px;
    }
    .hc-metric-label {
      font-size: 10px;
      color: var(--text-sub);
      margin-top: 2px;
    }

    /* 谈资金句 */
    .hc-quote {
      background: #f8f9fc;
      border-radius: 8px;
      padding: 8px 12px;
      font-size: 12px;
      color: #3a4a60;
      line-height: 1.55;
      border-left: 3px solid #dde3f0;
      display: flex;
      gap: 6px;
      align-items: flex-start;
    }
    .hc-quote-icon { flex-shrink: 0; font-size: 13px; margin-top: 1px; }

    /* 底部操作行 */
    .hc-footer {
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }
    .hc-detail-btn {
      font-size: 11px;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
      display: flex; align-items: center; gap: 3px;
      padding: 4px 8px;
      border-radius: 6px;
      background: #fce8e6;
      cursor: pointer;
      border: none;
      transition: background 0.15s;
    }
    .hc-detail-btn:hover { background: #f9d0cd; }

    /* 底部今日行动建议 */
    .action-suggestion {
      background: linear-gradient(135deg, #1a2942 0%, #1a3464 100%);
      border-radius: 14px;
      padding: 18px 20px;
      margin-top: 16px;
      color: #fff;
    }
    .as-title {
      font-size: 12px; font-weight: 700;
      color: rgba(255,255,255,0.65);
      margin-bottom: 12px;
      display: flex; align-items: center; gap: 6px;
    }
    .as-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .as-item {
      background: rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 10px 12px;
      border: 1px solid rgba(255,255,255,0.12);
    }
    .as-item-label { font-size: 10px; color: rgba(255,255,255,0.5); margin-bottom: 4px; }
    .as-item-content { font-size: 12px; color: rgba(255,255,255,0.9); line-height: 1.5; }
    .as-disclaimer {
      margin-top: 10px;
      font-size: 10px;
      color: rgba(255,255,255,0.4);
      text-align: center;
    }

    /* 桌面端最大宽度限制（保持手机视觉风格） */
    .snappy-container {
      max-width: 480px;
      margin: 0 auto;
    }
    @media (min-width: 700px) {
      .snappy-container {
        max-width: 540px;
      }
    }

    /* ─── 原有板块卡片样式 ─── */
    .topic-card {
      background: var(--card-bg);
      border-radius: 16px;
      box-shadow: var(--shadow);
      margin-bottom: 32px;
      overflow: hidden;
      border: 1px solid var(--border);
      transition: box-shadow 0.2s;
    }
    .topic-card:hover { box-shadow: 0 6px 30px rgba(0,0,0,0.12); }
    .card-strip { height: 5px; }
    .card-body { padding: 24px; }
    .card-title-row { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 18px; }
    .card-num {
      min-width: 36px; height: 36px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; font-weight: 800; color: #fff; flex-shrink: 0;
    }
    .card-title-info { flex: 1; }
    .card-title-info h3 { font-size: 16px; font-weight: 700; color: var(--primary); line-height: 1.4; }
    .card-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .tag { font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 12px; }

    .modules-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
    @media (max-width: 1200px) { .modules-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 700px) { .modules-grid { grid-template-columns: 1fr; } }

    .module-box {
      border-radius: 12px; padding: 16px;
      border: 1px solid var(--border);
      background: #fafbfd; position: relative;
    }
    .module-header { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
    .module-icon {
      width: 28px; height: 28px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center; font-size: 14px;
    }
    .module-title { font-size: 12px; font-weight: 700; color: var(--text-sub); text-transform: uppercase; letter-spacing: 0.5px; }
    .module-num { font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 6px; background: rgba(0,0,0,0.06); color: var(--text-sub); }

    .module-news .module-icon { background: #e8f0fe; }
    .module-news { border-top: 3px solid #4285f4; }
    .news-summary { font-size: 13px; color: var(--text-main); line-height: 1.7; }
    .news-highlight {
      display: inline-block; background: #fff3cd;
      border-left: 3px solid var(--gold);
      padding: 8px 12px; border-radius: 0 6px 6px 0;
      font-size: 12px; color: #7a5500; margin-top: 10px; width: 100%; line-height: 1.5;
    }
    .module-metrics .module-icon { background: #e8f5e9; }
    .module-metrics { border-top: 3px solid var(--green); }
    .metrics-list { display: flex; flex-direction: column; gap: 8px; }
    .metric-item {
      display: flex; justify-content: space-between; align-items: center;
      padding: 7px 10px; background: #fff; border-radius: 8px; border: 1px solid var(--border);
    }
    .metric-name { font-size: 12px; color: var(--text-sub); }
    .metric-val { font-size: 14px; font-weight: 700; }
    .metric-chg { font-size: 11px; font-weight: 600; padding: 2px 6px; border-radius: 4px; }
    .val-up { color: var(--red); }
    .val-down { color: var(--green); }
    .val-neutral { color: var(--text-sub); }
    .chg-up { background: #fce8e6; color: var(--red); }
    .chg-down { background: #e6f4ea; color: var(--green); }
    .chg-neutral { background: #f0f0f0; color: var(--text-sub); }

    .module-analysis .module-icon { background: #fff3e0; }
    .module-analysis { border-top: 3px solid #ff9800; }
    .analysis-content { font-size: 13px; color: var(--text-main); line-height: 1.7; }
    .analysis-actions { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }
    .action-item {
      display: flex; align-items: flex-start; gap: 8px;
      padding: 8px 10px; border-radius: 8px; background: #fff; border: 1px solid var(--border);
      font-size: 12px; line-height: 1.5;
    }
    .action-icon { font-size: 14px; flex-shrink: 0; margin-top: 1px; }
    .institution-label {
      display: inline-block; font-size: 10px; font-weight: 700;
      padding: 1px 6px; border-radius: 4px; margin-right: 4px;
    }
    .module-tips .module-icon { background: #f3e8ff; }
    .module-tips { border-top: 3px solid #9c27b0; }
    .tip-list { display: flex; flex-direction: column; gap: 7px; }
    .tip-item {
      display: flex; align-items: flex-start; gap: 8px;
      font-size: 12px; line-height: 1.6;
      padding: 8px 10px; background: #fff; border-radius: 8px; border: 1px solid #e8d5f5;
    }
    .tip-bullet {
      width: 18px; height: 18px; border-radius: 50%;
      background: #9c27b0; color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-size: 10px; font-weight: 700; flex-shrink: 0; margin-top: 1px;
    }
    .tip-caution {
      display: flex; align-items: flex-start; gap: 8px; margin-top: 8px;
      padding: 8px 10px; background: #fff8e1; border-radius: 8px;
      border-left: 3px solid #ff9800; font-size: 11px; color: #7a5000;
    }

    .summary-panel {
      background: linear-gradient(135deg, #1a2942 0%, #1a3464 100%);
      border-radius: 16px; padding: 24px; margin-bottom: 24px; color: #fff;
    }
    .summary-title { font-size: 14px; font-weight: 700; color: rgba(255,255,255,0.7); margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
    .summary-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
    @media (max-width: 900px) { .summary-grid { grid-template-columns: repeat(2, 1fr); } }
    .summary-item { background: rgba(255,255,255,0.08); border-radius: 12px; padding: 16px; border: 1px solid rgba(255,255,255,0.12); }
    .summary-item .label { font-size: 11px; color: rgba(255,255,255,0.55); }
    .summary-item .value { font-size: 22px; font-weight: 800; margin: 6px 0; }
    .summary-item .detail { font-size: 11px; }

    /* ─── FOOTER ─── */
    .footer { background: #fff; border-top: 1px solid var(--border); padding: 16px 28px; margin-top: 32px; }
    .footer-inner {
      max-width: 1600px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      font-size: 11px; color: var(--text-sub); flex-wrap: wrap; gap: 8px;
    }
    .footer-disclaimer {
      background: #fff8e1; border-radius: 6px; padding: 4px 10px;
      border-left: 3px solid var(--gold); font-size: 11px; color: #7a5500;
    }
  </style>
</head>
<body>

<!-- ═══════════════ HEADER ═══════════════ -->
<header class="header">
  <div class="header-inner">
    <div class="header-left">
      <div class="header-logo">
        <div class="logo-icon">📊</div>
        <div class="header-title">
          <h1>每日经济热点案例展示板</h1>
          <div class="subtitle">银行直营客户经理 · 每日资讯工作流系统</div>
        </div>
      </div>
    </div>
    <div class="header-meta">
      <span class="version-badge">V 1.1</span>
      <div class="date-badge">📅 2026年4月21日 &nbsp;|&nbsp; 周二</div>
      <div class="market-status">
        <div class="status-dot"></div>
        <span class="status-text">今日数据</span>
      </div>
    </div>
  </div>
  <!-- Ticker Bar -->
  <div class="ticker-bar">
    <div class="ticker-inner">
      <div class="ticker-item">
        <span class="ticker-label">沪指</span>
        <span class="ticker-val">4085.20</span>
        <span class="ticker-chg up">▲ +0.07%</span>
      </div>
      <div class="sep"></div>
      <div class="ticker-item">
        <span class="ticker-label">深成指</span>
        <span class="ticker-val">15016.03</span>
        <span class="ticker-chg up">▲ +0.10%</span>
      </div>
      <div class="sep"></div>
      <div class="ticker-item">
        <span class="ticker-label">创业板指</span>
        <span class="ticker-val">3689.10</span>
        <span class="ticker-chg up">▲ +0.31%</span>
      </div>
      <div class="sep"></div>
      <div class="ticker-item">
        <span class="ticker-label">科创50</span>
        <span class="ticker-val">1450.52</span>
        <span class="ticker-chg up">▲ +1.91%</span>
      </div>
      <div class="sep"></div>
      <div class="ticker-item">
        <span class="ticker-label">布伦特原油</span>
        <span class="ticker-val">$96.8</span>
        <span class="ticker-chg down">▼ -2.6%</span>
      </div>
      <div class="sep"></div>
      <div class="ticker-item">
        <span class="ticker-label">1年期LPR</span>
        <span class="ticker-val">3.0%</span>
        <span class="ticker-chg neutral">— 维持</span>
      </div>
      <div class="sep"></div>
      <div class="ticker-item">
        <span class="ticker-label">5年期LPR</span>
        <span class="ticker-val">3.5%</span>
        <span class="ticker-chg neutral">— 维持</span>
      </div>
